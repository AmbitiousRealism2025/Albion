#!/usr/bin/env bash
set -euo pipefail

# T3 Code launches provider binaries from the app environment, which may not
# inherit shell-profile exports. Load Albion's local secrets file, then delegate
# to the normal launcher so all endpoint/model/plugin behavior stays centralized.

resolve_script_dir() {
  local source_path
  local source_dir

  source_path="${BASH_SOURCE[0]}"
  while [ -h "$source_path" ]; do
    source_dir="$(cd -P "$(dirname "$source_path")" && pwd)"
    source_path="$(readlink "$source_path")"
    case "$source_path" in
      /*) ;;
      *) source_path="${source_dir}/${source_path}" ;;
    esac
  done

  cd -P "$(dirname "$source_path")" && pwd
}

source_readable_file() {
  local file_path
  file_path="$1"

  if [ -n "$file_path" ] && [ -r "$file_path" ]; then
    # shellcheck source=/dev/null
    . "$file_path"
    return 0
  fi

  return 1
}

source_albion_secrets() {
  local candidate

  if [ -n "${ALBION_SECRETS_FILE:-}" ]; then
    if ! source_readable_file "$ALBION_SECRETS_FILE"; then
      printf 'Albion secrets file is not readable: %s\n' "$ALBION_SECRETS_FILE" >&2
      return 1
    fi
    return 0
  fi

  if [ -z "${HOME:-}" ]; then
    return 0
  fi

  for candidate in "${HOME}/.albion/secrets.sh" "${HOME}/.albion/secrets.zsh"; do
    if source_readable_file "$candidate"; then
      return 0
    fi
  done

  return 0
}

main() {
  local script_dir
  script_dir="$(resolve_script_dir)"

  source_albion_secrets
  exec "${script_dir}/albion" "$@"
}

main "$@"
